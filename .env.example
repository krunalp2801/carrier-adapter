# With none of this set, every carrier runs against its bundled sandbox and
# `npm run demo` works offline. Fill in a section to talk to a real sandbox.

# --- DHL Parcel DE Shipping (REST, JSON) -------------------------------------
# DHL_API_URL=https://api-sandbox.dhl.com/parcel/de/shipping/v2
# DHL_API_KEY=
# DHL_BILLING_NUMBER=

# --- DPD Web Connect (SOAP, XML) ---------------------------------------------
# Auth is a two-step dance: login once with the delis id and password to get a
# token, then send the token in a SOAP header on every call. The token expires
# and the expiry is reported as a generic fault, see the README.
# DPD_API_URL=https://public-ws-stage.dpd.com/services/ShipmentService/V3_2
# DPD_DELIS_ID=
# DPD_PASSWORD=

# --- GLS ShipIT (REST, JSON, basic auth) -------------------------------------
# GLS_API_URL=https://shipit-wbm-test01.gls-group.eu:8443/backend/rs
# GLS_USERNAME=
# GLS_PASSWORD=
# GLS_CONTACT_ID=
